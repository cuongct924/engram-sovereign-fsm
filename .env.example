# Docker Image Versions
CELESTIA_APP_VERSION=v1.11.0
CELESTIA_NODE_VERSION=v0.14.1
BITCOIN_VERSION=v25.0

# Bitcoin Regtest Configuration (used by docker/bitcoin-regtest-cluster.yml's
# containers themselves, via --env-file)
BITCOIN_RPC_USER=
BITCOIN_RPC_PASSWORD=

# `engramd start`'s own Bitcoin RPC connection (x/vigilante/rpc.go,
# wireBTCSensor in cmd/engramd/main.go) -- host-side, port-mapped endpoint,
# not the in-container one bitcoin-regtest-cluster.yml's services use above.
# Same BITCOIN_RPC_USER/BITCOIN_RPC_PASSWORD as above. Leave BITCOIN_HOST
# unset to run engramd without live BTC sensor wiring (falls back to the
# static mock).
BITCOIN_HOST=127.0.0.1
BITCOIN_RPC_PORT=18443

# `engramd start`'s own Celestia bridge connection (x/da/rpc.go,
# wireDASensor in cmd/engramd/main.go) -- host-side, port-mapped
# celestia-bridge RPC (docker/celestia-local-cluster.yml). Leave
# CELESTIA_BRIDGE_URL unset to run engramd without live DA sensor wiring
# (falls back to the static mock).
CELESTIA_BRIDGE_URL=http://127.0.0.1:26658
# Admin/write JWT -- regenerated per celestia-bridge container instance, so
# there is no stable default; fetch a fresh one after the container is up:
#   docker exec celestia-bridge cat /home/celestia/bridge_auth.txt
CELESTIA_BRIDGE_AUTH_TOKEN=
# At most 10 bytes; defaults to "engramda01" in wireDASensor if unset.
CELESTIA_NAMESPACE_ID=engramda01