# Docker Image Versions
CELESTIA_APP_VERSION=v1.11.0
CELESTIA_NODE_VERSION=v0.14.1
BITCOIN_VERSION=v25.0

# Bitcoin Regtest Configuration (used by docker/bitcoin-regtest-cluster.yml's
# containers themselves, via --env-file)
BITCOIN_RPC_USER=
BITCOIN_RPC_PASSWORD=

# `engramd start`'s own Bitcoin RPC connection (host-side, port-mapped --
# not the in-container endpoint bitcoin-regtest-cluster.yml uses above).
# Leave BITCOIN_HOST unset to run without live BTC sensor wiring.
BITCOIN_HOST=127.0.0.1
BITCOIN_RPC_PORT=18443

# `engramd start`'s own Celestia bridge connection (host-side, port-mapped
# celestia-bridge RPC). Leave CELESTIA_BRIDGE_URL unset to run without
# live DA sensor wiring.
CELESTIA_BRIDGE_URL=http://127.0.0.1:26658
# Admin/write JWT -- regenerated per celestia-bridge container instance, so
# there is no stable default; fetch a fresh one after the container is up:
#   docker exec celestia-bridge cat /home/celestia/bridge_auth.txt
CELESTIA_BRIDGE_AUTH_TOKEN=
# At most 10 bytes; defaults to "engramda01" in wireDASensor if unset.
CELESTIA_NAMESPACE_ID=engramda01

# x/sovereignty Params (spec/core/EngramFSM.tla CONSTANTS) -- consensus-
# critical, so read ONLY by `engramd init`/`testnet init-files` (baked into
# the shared genesis.json), never by `start`. Unset = DefaultParams()
# (x/sovereignty/types/params.go). Validated as a whole at genesis time
# (Params.Validate) -- an invalid combination fails generation loudly
# instead of deploying silently.

# BTC settlement
ENGRAM_PARAM_SUSPICIOUS_THRESHOLD=5      # btc_gap -> SUSPICIOUS
ENGRAM_PARAM_SOVEREIGN_THRESHOLD=8       # btc_gap -> SOVEREIGN (must exceed SUSPICIOUS_THRESHOLD)
ENGRAM_PARAM_K_DEEP_FINALITY=2           # BTC confirmations before an anchor counts
ENGRAM_PARAM_MAX_UNPROVEN_TAIL_BLOCKS=8  # max tip lag still covered by a valid re-anchor proof

# DA
ENGRAM_PARAM_DA_THRESHOLD=30             # da_gap health cutoff

# Hysteresis / recovery
ENGRAM_PARAM_HYSTERESIS_WAIT=2           # safe_blocks before RECOVERING -> ANCHORED
ENGRAM_PARAM_MAX_SUSPICIOUS_TIME=24      # blocks in SUSPICIOUS before escalating to SOVEREIGN

# P2P health
ENGRAM_PARAM_MIN_PEERS=3                 # min clean (non-blacklisted) peers
ENGRAM_PARAM_MIN_SUBNET_DIVERSITY=2      # min distinct peer subnets
ENGRAM_PARAM_MIN_ANCHOR_PEERS=2          # min active anchor/bootstrap peers
ENGRAM_PARAM_MAX_CHURN_RATE=5            # max peer disconnects/reconnects per epoch
ENGRAM_PARAM_MIN_AVG_TENURE=300          # min average peer tenure, seconds
ENGRAM_PARAM_MAX_PEER_LATENCY=200        # max peer RTT, milliseconds

# Ingress / censorship
ENGRAM_PARAM_MAX_IGNORE_ROUNDS=1         # rounds a forced tx may be skipped before IsCensoring trips
ENGRAM_PARAM_MAX_PEERS_PER_SUBNET=8      # FilterPeerByAddr's same-subnet peer cap