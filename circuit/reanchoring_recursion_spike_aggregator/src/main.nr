fn main(
    rt_start: pub Field,
    rt_end: pub Field,
    leaf_proofs: [UltraHonkZKProof; M],
    leaf_rt_last: [Field; M],
    leaf_rt_new: [Field; M],
    leaf_key_hash: Field, // identical across leaves: same circuit -> same VK -> same key_hash
) {
    for i in 0..M {
        verify_honk_proof(LEAF_VK, leaf_proofs[i], [leaf_rt_last[i], leaf_rt_new[i]], leaf_key_hash);
    }
    assert(leaf_rt_last[0] == rt_start);
    for i in 1..M {
        // leaf i's rt_last must equal leaf i-1's rt_new -- chains the leaves,
        // replicating at the aggregate level what one big-N circuit would do.
        assert(leaf_rt_last[i] == leaf_rt_new[i - 1]);
    }
    assert(leaf_rt_new[M - 1] == rt_end);
}
