# The ENGRAM_PARAM_* values of the paper's experiments (Appendix F, "FSM parameters"). The code runs on its own defaults when a value is
# missing, and those differ from these in four places (marked "!"): a deployment that omits them measures another system.
# Docker testbed: copy these lines into .env. Multi-host cluster: deploy/ansible/group_vars/all.yml sets the same values in `engram_params`
# (tests in internal/invariants keep the two in step); the only difference is MAX_PEER_LATENCY, see below.

ENGRAM_PARAM_SUSPICIOUS_THRESHOLD=5          # Bitcoin gap that leads to SUSPICIOUS (default)
ENGRAM_PARAM_SOVEREIGN_THRESHOLD=8           # Bitcoin gap that leads to SOVEREIGN (default)
ENGRAM_PARAM_K_DEEP_FINALITY=2               # Bitcoin confirmations before an anchor counts (default)
ENGRAM_PARAM_DA_THRESHOLD=30                 # DA gap that counts as unhealthy, in Engram blocks (default)
ENGRAM_PARAM_HYSTERESIS_WAIT=2               # safe blocks before RECOVERING -> ANCHORED (default)
ENGRAM_PARAM_DOWN_HYSTERESIS_THRESHOLD=2     # unhealthy blocks before leaving ANCHORED (default)
ENGRAM_PARAM_MAX_SUSPICIOUS_TIME=24          # blocks in SUSPICIOUS before SOVEREIGN (default)
ENGRAM_PARAM_MIN_PEERS=3                     # peer-health thresholds (defaults)
ENGRAM_PARAM_MIN_SUBNET_DIVERSITY=2
ENGRAM_PARAM_MIN_ANCHOR_PEERS=2
ENGRAM_PARAM_MAX_CHURN_RATE=5
ENGRAM_PARAM_MIN_AVG_TENURE=300
ENGRAM_PARAM_MAX_IGNORE_ROUNDS=1
ENGRAM_PARAM_MAX_PEERS_PER_SUBNET=8

# ! The tail bound the recovery gate accepts (default 8). 128 is above r*L*(1+1/N) of every measured setting (Section 8, "How the prover keeps up").
ENGRAM_PARAM_MAX_UNPROVEN_TAIL_BLOCKS=128
# ! Recovery needs a verified proof; the heuristic fallback is off (default false).
ENGRAM_PARAM_PROOF_ONLY_RECOVERY=true
# ! Cap of the backed-off down threshold equal to the threshold itself: the threshold is static, adaptive backoff off (default 8).
ENGRAM_PARAM_MAX_DOWN_HYSTERESIS_THRESHOLD=2
# ! Wait before SUSPICIOUS -> ANCHORED (default 2).
ENGRAM_PARAM_SUSPICIOUS_HYSTERESIS_WAIT=8

# Maximum peer round trip in milliseconds. 200 on the single-host Docker testbed (default). The multi-host cluster sets 500: real
# round trips between continents reach 207 ms (Table tab:testbedB), so 200 would make every validator report unhealthy P2P.
ENGRAM_PARAM_MAX_PEER_LATENCY=200
