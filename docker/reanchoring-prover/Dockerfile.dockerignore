# Per-Dockerfile override (BuildKit's <dockerfile-path>.dockerignore) --
# same as the root .dockerignore, but circuit/ and scripts/ aren't fully
# excluded since this image needs reanchoring(_witness) + reanchoring_prover.

# VCS / editor / tooling
.git
.github
.gitignore
.claude
.idea
.vscode
**/.DS_Store

# Logs / PID files
**/*.log
nohup.out
**/*.pid

# Language toolchains not needed for this build
node_modules
.venv
dist
build
tmp

# Not needed for this build
spec
tests
docs
docker
proto
buf.gen.yaml
buf.lock
buf.yaml

# Local env / secrets -- never needed at build time
.env
.env.example
.air.toml

# Runtime data bind-mounted from containers, and generated testnet homes --
# unbounded growth, never needed for this build.
data
testnet-data

# Built binary artifacts
engramd

# Docs / config / root files
*.md
LICENSE
Makefile
requirements.txt
compose.yml
celestia-cluster-compose.yml
bitcoin-cluster-compose.yml
engram-validator-compose.yml
engram-cluster-compose.dev.yml
.golangci.yml
Dockerfile.dev

# circuit/: only reanchoring + reanchoring_witness needed. The recursion-
# spike experiments (NO-GO, see their RESULTS.md) are dead weight; target/
# excluded so builds prove fresh.
circuit/reanchoring_recursion_spike
circuit/reanchoring_recursion_spike_aggregator
circuit/reanchoring/target
circuit/reanchoring_witness/target

# scripts/: only reanchoring_prover is needed. e6's benchmark vendors a
# 216M Plonky3 checkout that has no business in any Docker build context.
scripts/e2_fault_injection
scripts/e3_failure_matrix
scripts/e4_p2p_eclipse_detection
scripts/e5_hysteresis_flapping
scripts/e6_zk_reanchoring_benchmark
scripts/e7_consensus_overhead
scripts/e8_attack_resilience
scripts/e9_trace_driven
scripts/framework
scripts/notebooks
scripts/__pycache__
scripts/bitcoin_miner_loop.sh
scripts/testnet_double_sign_toggle.sh
scripts/testnet_fetch_celestia_token.sh
scripts/testnet_fund_wallet.sh
scripts/utils.py
