# Per-Dockerfile override (BuildKit's <dockerfile-path>.dockerignore) for
# docker/reanchoring-prover/Dockerfile -- same as the root .dockerignore
# except circuit/ and scripts/ aren't blanket-excluded, since this image
# needs circuit/reanchoring(_witness) and scripts/reanchoring_prover.
.git
.github
.gitignore
.DS_Store
.idea
.vscode
.claude
*.log
node_modules
dist
build
tmp
testdata
spec
tests

# Runtime data bind-mounted from running containers, and generated testnet
# homes -- unbounded growth, never needed for this build.
data
testnet-data

*.md
LICENSE
.env.example
.golangci.yml
Makefile
requirements.txt
Dockerfile.dev
.air.toml

# circuit/: only reanchoring + reanchoring_witness are needed. The
# recursion-spike experiments (NO-GO, see their own RESULTS.md) are dead
# weight; each circuit's target/ is excluded so builds prove fresh.
circuit/reanchoring_recursion_spike
circuit/reanchoring_recursion_spike_aggregator
circuit/reanchoring/target
circuit/reanchoring_witness/target

# scripts/: only reanchoring_prover is needed. e6's benchmark vendors a
# 216M Plonky3 checkout that has no business in any Docker build context.
scripts/e2_fault_injection
scripts/e3_failure_matrix
scripts/e4_p2p_eclipse_detection
scripts/e5_hysteresis_flapping
scripts/e6_zk_reanchoring_benchmark
scripts/e7_consensus_overhead
scripts/e8_attack_resilience
scripts/e9_trace_driven
scripts/framework
scripts/notebooks
scripts/__pycache__
scripts/bitcoin_miner_loop.sh
scripts/testnet_double_sign_toggle.sh
scripts/testnet_fetch_celestia_token.sh
scripts/testnet_fund_wallet.sh
scripts/utils.py
