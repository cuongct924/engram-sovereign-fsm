# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.old
*.out
coverage.*
*.coverprofile
profile.cov

# Dependency directories (remove the comment below to include it)
vendor/

# Go workspace file
go.work
go.work.sum

# env file
.venv/
venv/
.env
__pycache__/
*.pyc
**.DS_Store

# Editor/IDE
.idea/
.vscode/

# TLA+ artifacts
spec/tla2tools.jar
states/
*_TTrace_*.tla
*_TTrace_*.bin
*.tla.txt
*.cfg.txt

# Apalache artifacts (transient run output; curated .itf.json traces kept elsewhere are committed deliberately)
_apalache-out/

*.dot.dump

# Noir execution artifacts
target/
proofs/

# Plonky3 checkout cloned by benchmark_plonky3.sh (E6 Table 6C, external toolchain, not vendored)
scripts/e6_zk_reanchoring_benchmark/.plonky3_checkout/


# Private inputs
Prover.toml

# Verifier inputs (Optional to ignore, but usually not needed)
Verifier.toml


# Local bind mound service data
data/

# Generated multi-node testnet genesis/config/keys (engramd testnet init-files)
testnet-data/


# File backup
*.back
*.backup
*.bak
*.bakup


# Currently unnecessary file
docs/spec/core/EngramTypes.tla


build/
# Anchored to repo root only -- an unanchored "engramd" here previously
# matched the cmd/engramd/ directory too (gitignore patterns with no "/"
# match a path component at any depth), silently excluding every file added
# to that directory after this rule existed (e8_cli.go, its tests) from git
# entirely, even though they built and tested fine locally. That's what
# caused a real CI failure (undefined: txSubmitForcedTxCmd) despite the
# function existing on disk -- it just never reached the pushed commit.
/engramd

.claude/worktrees
spec/.claude