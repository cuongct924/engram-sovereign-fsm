# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.old
*.out
coverage.*
*.coverprofile
profile.cov

# Dependency directories (remove the comment below to include it)
vendor/

# Go workspace file
go.work
go.work.sum

# env file
.venv/
venv/
.env
__pycache__/
*.pyc
**.DS_Store
.DS_Store

# Editor/IDE
.idea/
.vscode/

# TLA+ artifacts
spec/tla2tools.jar
states/
*_TTrace_*.tla
*_TTrace_*.bin
*.tla.txt
*.cfg.txt

# Apalache artifacts (transient run output; curated .itf.json traces kept elsewhere are committed deliberately)
_apalache-out/

*.dot.dump

# Noir execution artifacts
target/
proofs/

# Plonky3 checkout cloned by benchmark_plonky3.sh (E6 Table 6C, external toolchain, not vendored)
scripts/e6_zk_reanchoring_benchmark/.plonky3_checkout/
# Ditto for benchmark_plonky3_full_statement.sh -- a separate, newer-pinned checkout
# (needs p3-sha256-air, absent at the Table 6C commit).
scripts/e6_zk_reanchoring_benchmark/plonky3_full_statement/.plonky3_checkout/
scripts/e6_zk_reanchoring_benchmark/plonky3_full_statement/Cargo.lock


# Private inputs
Prover.toml

# Verifier inputs (Optional to ignore, but usually not needed)
Verifier.toml


# Local bind mound service data
data/

# Generated multi-node testnet genesis/config/keys (engramd testnet init-files)
testnet-data/


# File backup
*.back
*.backup
*.bak
*.bakup


# Currently unnecessary file
docs/spec/core/EngramTypes.tla


build/

# LaTeX build artifacts (docs/paper/) -- regenerated by pdflatex/bibtex every
# build; docs/paper.pdf (from `make paper`) is committed intentionally so the
# paper is viewable without a LaTeX toolchain.
docs/paper/main.pdf
*.aux
*.bbl
*.blg
*.log
*.synctex.gz
*.fls
*.fdb_latexmk
# Anchored to root -- without the "/", "engramd" would also match the
# cmd/engramd/ directory and silently exclude its files (e.g. e8_cli.go)
# from git, causing CI failures that don't reproduce locally.
/engramd

# Raw (uncompressed) zk verifier WASM binary -- only the gzip-compressed
# barretenberg.wasm.gz is committed (the raw build output is 80-115MB,
# over GitHub's 100MB file limit; see x/sovereignty/keeper/zk_verifier.go
# and https://github.com/cuongct924/engram-barretenberg-wasm).
x/sovereignty/keeper/zk_assets/*.wasm

.claude/worktrees
.claude/settings.local.json
# deploy/: Terraform state and provider caches, generated inventory, controller-side genesis and keys
deploy/.generated/
deploy/ansible/inventory/hosts.yml
deploy/terraform/**/.terraform/
deploy/terraform/**/.terraform.lock.hcl
deploy/terraform/**/*.tfstate
deploy/terraform/**/*.tfstate.*
deploy/terraform/**/terraform.tfvars
